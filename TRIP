<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>曼谷 11/10–11/15 行程</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap">
<style>
:root{--bg:#F2F4F1;--card:#FFFFFF;--ink:#1B2A29;--mute:#5C6B69;--line:#D5DCD8;--jade:#1F7A6B;--accent:#8F6100;
--sp-1:4px;--sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-5:24px;--sp-6:32px;
--fs-xs:12px;--fs-sm:14px;--fs-md:16px;--fs-lg:18px;--fs-xl:24px;
--r-sm:6px;--r-md:10px;--r-pill:999px;--tap:44px;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121A19;--card:#1B2625;--ink:#E8EFEC;--mute:#9AAAA6;--line:#2C3B39;--jade:#4CC3AD;--accent:#E3B04B}}
:root[data-theme="dark"]{--bg:#121A19;--card:#1B2625;--ink:#E8EFEC;--mute:#9AAAA6;--line:#2C3B39;--jade:#4CC3AD;--accent:#E3B04B}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Noto Sans TC",system-ui,-apple-system,"PingFang TC","Microsoft JhengHei",sans-serif;line-height:1.65}
main{max-width:640px;margin:0 auto;padding:var(--sp-5) var(--sp-4) 56px}
h1{font-size:clamp(34px,9vw,52px);font-weight:900;line-height:1.1;margin:var(--sp-2) 0 6px}
.sub{color:var(--mute);margin:0 0 var(--sp-5)}
.facts{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-3);margin-bottom:var(--sp-6)}
.facts div{border-left:3px solid var(--jade);padding-left:var(--sp-3);font-size:var(--fs-sm);color:var(--mute)}
.facts b{display:block;color:var(--ink);font-size:15px}
.day{margin-bottom:var(--sp-6)}
.day-head{display:flex;align-items:baseline;gap:var(--sp-3);border-bottom:2px solid var(--ink);padding-bottom:6px}
.day-date{font-size:var(--fs-xl);font-weight:900}
.day-theme{color:var(--jade);font-weight:700}
.day-note{font-size:var(--fs-sm);color:var(--mute);margin:6px 0 var(--sp-1)}
ul{list-style:none;margin:0;padding:0}
.stop{display:grid;grid-template-columns:var(--tap) 56px 1fr;gap:var(--sp-2);padding:var(--sp-3) 0;border-bottom:1px solid var(--line);align-items:start}
.stop-check{width:24px;height:24px;margin:10px 10px;accent-color:var(--jade);cursor:pointer}
.stop-time{color:var(--accent);font-weight:700;font-size:var(--fs-sm);padding-top:var(--sp-2)}
.stop-name{font-weight:700;font-size:var(--fs-lg);padding-top:var(--sp-1)}
.stop-name a{color:inherit;text-decoration:underline;text-decoration-color:var(--jade);text-underline-offset:4px;text-decoration-thickness:2px}
.stop-name a:hover{color:var(--jade)}
a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.stop.is-done .stop-name{text-decoration:line-through;opacity:.6}
.stop-desc{font-size:var(--fs-sm);color:var(--mute)}
.alt-tag{display:inline-block;margin-left:var(--sp-2);font-size:var(--fs-xs);font-weight:500;color:var(--accent);border:1px solid var(--accent);border-radius:var(--r-sm);padding:0 6px;vertical-align:2px}
.swap-btn,.route-btn{display:inline-flex;align-items:center;justify-content:center;min-height:var(--tap);font:inherit;font-size:var(--fs-sm);font-weight:500;color:var(--jade);background:transparent;border:1.5px solid var(--jade);border-radius:var(--r-pill);padding:0 var(--sp-4);cursor:pointer;text-decoration:none;margin-top:var(--sp-2)}
.swap-btn:hover,.route-btn:hover{background:var(--jade);color:var(--bg)}
.swap-btn:active,.route-btn:active{transform:translateY(1px)}
.route-btn{margin-top:var(--sp-4);margin-right:var(--sp-2)}
.home-btn{color:var(--accent);border-color:var(--accent)}
.home-btn:hover{background:var(--accent);color:var(--bg)}
.info{font-size:var(--fs-sm);color:var(--mute);margin:var(--sp-3) 0 0}
.info b{color:var(--ink)}
.callout{background:var(--card);border:1px dashed var(--line);border-radius:var(--r-md);padding:var(--sp-4);font-size:15px}
.callout--note{border-style:solid;font-size:var(--fs-sm);color:var(--mute);border:0}
.callout--note b{color:var(--ink)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
footer{margin-top:var(--sp-5);font-size:var(--fs-xs);color:var(--mute)}
@media print{:root{--bg:#fff;--card:#fff;--ink:#000;--mute:#333;--line:#bbb;--jade:#145a4e;--accent:#6b4900}.swap-btn,.stop-check{display:none}.route-btn{border:0;min-height:0;padding:0;margin-right:var(--sp-4);text-decoration:underline;color:var(--jade)}.home-btn{color:var(--accent)}.stop{grid-template-columns:56px 1fr}.day{break-inside:avoid}}
</style>
</head>
<body>
<main>
