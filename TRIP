["上午","Abandoned Mansion Bangkok","在 Sukhumvit 14，BTS 到 Asok 或 Nana 周邊","15870122832082825760","13.7352580,100.5601969",[["GLOW coffee","在 Sukhumvit 路上，通羅一帶，離 Record Bar 很近","3556709339955199285","13.7234733,100.5799621"],["Thaipioka","在 Thonglor Soi 1","14078534897909846504","13.7272999,100.5786277"],["Dib Bangkok","在 Sukhumvit 40","4304372662025851268","13.7129126,100.5797653"],["恰圖恰市集 Chatuchak Weekend Market","週六也營業，建議一早去。在北邊，換了之後下面兩站要重排","10516346959717498187","13.7997810,100.5504245"]]],
["中午","Chenin Restaurant","在 Sukhumvit 31，從上一站搭計程車很快","13740527445722072691","13.7376520,100.5667057",[["Thaipioka","在 Thonglor Soi 1，搭計程車過去","14078534897909846504","13.7272999,100.5786277"],["GLOW coffee","在 Sukhumvit 路上，通羅一帶","3556709339955199285","13.7234733,100.5799621"],["BENKOFF","在 Thonglor 的 NT TOWER","18252664058542019756","13.7315085,100.5811710"]]],
["晚上","Modern-Day Culture : Record Bar","在 Sukhumvit 63，通羅一帶","8086624585196595373","13.7247232,100.5848045",[["BENKOFF","在 Thonglor 的 NT TOWER","18252664058542019756","13.7315085,100.5811710"],["Route66","在 Rama 9 一帶，離通羅較遠，需搭計程車","10696069871793886312","13.7514844,100.5753316"]]]]},
