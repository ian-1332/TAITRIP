var S={},done={},STORE="bkk-done";
try{done=JSON.parse(localStorage.getItem(STORE)||"{}")}catch(e){}
function save(){try{localStorage.setItem(STORE,JSON.stringify(done))}catch(e){}}
function cur(di,si){var p=D[di].s[si],o=[[p[1],p[2],p[3],p[4]]].concat(p[5]||[]);return{p:p,o:o,c:o[S[di+"-"+si]||0]}}
function taken(di,si,i){var nm=cur(di,si).o[i][0];return D[di].s.some(function(_,j){return j!==si&&cur(di,j).c[0]===nm})}
function esc(t){return String(t).replace(/&/g,"&amp;").replace(/</g,"&lt;")}
function route(di){var q=D[di].s.map(function(_,si){return cur(di,si).c[3]});
var u="https://www.google.com/maps/dir/?api=1&travelmode=driving&origin="+q[0]+"&destination="+q[q.length-1];
if(q.length>2)u+="&waypoints="+q.slice(1,-1).join("%7C");return u}
function day(di){var x=D[di],h='<div class="day-head"><span class="day-date">'+x.d+'</span><span class="day-theme">'+x.th+'</span></div><p class="day-note">'+x.note+'</p><ul>';
x.s.forEach(function(_,si){var r=cur(di,si),k=di+"-"+si,i=S[k]||0,c=r.c,dn=!!done[k];
h+='<li class="stop'+(dn?' is-done':'')+'"><input class="stop-check" type="checkbox" data-k="'+k+'" aria-label="已完成：'+esc(c[0])+'"'+(dn?' checked':'')+'><span class="stop-time">'+r.p[0]+'</span><div><div class="stop-name"><a href="'+M+c[2]+'" target="_blank" rel="noopener">'+esc(c[0])+'<span class="sr">（在新分頁開啟）</span></a>'+(i>0?'<span class="alt-tag">替代選項</span>':'')+'</div><div class="stop-desc">'+esc(c[1])+'</div>'+(r.o.length>1?'<button class="swap-btn" type="button" data-k="'+k+'">換一個（'+(i+1)+'/'+r.o.length+'）</button>':'')+'</div></li>'});
h+='</ul><p class="info"><b>車程（粗估）</b>　'+x.ride+'</p><p class="info"><b>雨天備案</b>　'+x.rain+'</p><a class="route-btn" href="'+route(di)+'" target="_blank" rel="noopener">用 Google 地圖看當天路線<span class="sr">（在新分頁開啟）</span></a> <a class="route-btn home-btn" href="https://maps.app.goo.gl/co2BURHPraVeQpS57" target="_blank" rel="noopener">回住處<span class="sr">（在新分頁開啟）</span></a>';
